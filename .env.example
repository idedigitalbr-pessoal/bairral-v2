# Configurações do Servidor NestJS
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Banco de Dados MySQL
DATABASE_URL="mysql://bairral_user:bairral_pass@localhost:3306/bairral_canal_etica"

# Configurações de CORS & Segurança
CORS_ORIGIN="*"

# Alternar Mocks do Frontend vs API NestJS Real
VITE_ENABLE_MOCKS=false

# Google Gemini API Key (Backend secret)
GEMINI_API_KEY=

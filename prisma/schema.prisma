generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum ReportType {
  DEVIATION
  HARASSMENT
  DISCRIMINATION
  FRAUD
  CORRUPTION
  SAFETY
  PRIVACY
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_TRIAGE
  UNDER_INVESTIGATION
  ACTION_PLAN
  CONCLUDED
  REJECTED
  ARCHIVED
}

enum SubmissionMode {
  ANONYMOUS
  IDENTIFIED
  CONFIDENTIAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionPlanStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                  String     @id @default(uuid())
  name                String
  email               String     @unique
  passwordHash        String
  status              UserStatus @default(ACTIVE)
  isFirstAccess       Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  unitId              String?
  departmentId        String?
  avatarUrl           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  userRoles              UserRole[]
  sessions               Session[]
  auditLogs              AuditLog[]
  assignedReports        Report[]             @relation("AssignedUser")
  assignedByReports      Assignment[]         @relation("AssignmentCreator")
  userAssignments        Assignment[]         @relation("AssignedUserAssignment")
  uploadedAttachments    Attachment[]
  publicMessages         PublicMessage[]
  internalComments       InternalComment[]
  responsibleActionPlans ActionPlan[]         @relation("ActionPlanResponsible")
  createdActionPlans     ActionPlan[]         @relation("ActionPlanCreator")
  actionPlanEvidences    ActionPlanEvidence[]
  notifications          Notification[]
  savedFilters           SavedFilter[]
}

model Role {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @db.Text
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Category {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  slaDays     Int      @default(15)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports  Report[]
  slaRules SlaRule[]
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  reports     Report[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String
  unitId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([unitId, code])
}

model Report {
  id                   String         @id @default(uuid())
  protocol             String         @unique
  trackingPasswordHash String
  type                 ReportType     @default(DEVIATION)
  title                String
  description          String         @db.Text
  submissionMode       SubmissionMode @default(ANONYMOUS)
  status               ReportStatus   @default(SUBMITTED)
  riskLevel            RiskLevel      @default(MEDIUM)
  priority             Priority       @default(MEDIUM)
  categoryId           String?
  unitId               String?
  departmentId         String?
  location             String?
  occurrenceDate       String?
  occurrenceTime       String?
  recurring            Boolean        @default(false)
  immediateRisk        Boolean        @default(false)
  previousAttempt      Boolean        @default(false)
  assignedUserId       String?
  dueAt                DateTime?
  closedAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedUser     User?             @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  reporterIdentity ReporterIdentity?
  peopleInvolved   PersonInvolved[]
  witnesses        Witness[]
  assignments      Assignment[]
  statusHistory    StatusHistory[]
  attachments      Attachment[]
  publicMessages   PublicMessage[]
  internalComments InternalComment[]
  actionPlans      ActionPlan[]

  @@index([status])
  @@index([protocol])
  @@index([categoryId])
  @@index([unitId])
  @@index([assignedUserId])
  @@index([deletedAt])
  @@index([createdAt])
}

model ReporterIdentity {
  id                          String   @id @default(uuid())
  reportId                    String   @unique
  nameEncrypted               String?  @db.Text
  emailEncrypted              String?  @db.Text
  phoneEncrypted              String?  @db.Text
  cpfEncrypted                String?  @db.Text
  relationToCompanyEncrypted String?  @db.Text
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model PersonInvolved {
  id              String   @id @default(uuid())
  reportId        String
  name            String
  role            String?
  department      String?
  involvementType String   @default("ACCUSED")
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Witness {
  id        String   @id @default(uuid())
  reportId  String
  name      String
  contact   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Assignment {
  id               String   @id @default(uuid())
  reportId         String
  assignedUserId   String
  assignedByUserId String
  roleInCase       String   @default("INVESTIGATOR")
  notes            String?  @db.Text
  assignedAt       DateTime @default(now())

  report       Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assignedUser User   @relation("AssignedUserAssignment", fields: [assignedUserId], references: [id], onDelete: Cascade)
  assignedBy   User   @relation("AssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id              String       @id @default(uuid())
  reportId        String
  previousStatus  ReportStatus?
  newStatus       ReportStatus
  changedByUserId String?
  reason          String?      @db.Text
  createdAt       DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model SlaRule {
  id         String    @id @default(uuid())
  categoryId String?
  riskLevel  RiskLevel
  slaDays    Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Attachment {
  id               String   @id @default(uuid())
  reportId         String
  fileName         String
  originalName     String
  mimeType         String
  fileSize         Int
  storagePath      String
  uploadedByUserId String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())

  report         Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedByUser User?  @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

model PublicMessage {
  id           String   @id @default(uuid())
  reportId     String
  senderType   String   @default("ADMIN") // ADMIN ou REPORTER
  senderUserId String?
  content      String   @db.Text
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderUser User?  @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

model InternalComment {
  id             String   @id @default(uuid())
  reportId       String
  authorUserId   String
  content        String   @db.Text
  isConfidential Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorUser User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ActionPlan {
  id                String           @id @default(uuid())
  reportId          String
  title             String
  description       String?          @db.Text
  responsibleUserId String?
  responsibleName   String?
  dueDate           DateTime?
  priority          Priority         @default(MEDIUM)
  status            ActionPlanStatus @default(OPEN)
  completionNotes   String?          @db.Text
  completedAt       DateTime?
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  report          Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  responsibleUser User?                @relation("ActionPlanResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser   User                 @relation("ActionPlanCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  evidences       ActionPlanEvidence[]

  @@index([reportId])
  @@index([status])
}

model ActionPlanEvidence {
  id               String   @id @default(uuid())
  actionPlanId     String
  fileName         String
  originalName     String
  mimeType         String
  fileSize         Int
  storagePath      String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  actionPlan     ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  uploadedByUser User       @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([actionPlanId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  title     String
  subject   String?
  content   String   @db.Text
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filterJson Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemSetting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String   @db.Text
  description     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}
